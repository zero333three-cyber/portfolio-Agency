{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ZeroThree Solutions — AI Automation & Technology Agency",
  "short_name": "ZeroThree",
  "description": "Premium AI agency building automation systems, AI agents, analytics platforms, web applications, and cloud solutions for growth-driven companies.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#07100f",
  "theme_color": "#32d399",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["business", "technology", "productivity"],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}

